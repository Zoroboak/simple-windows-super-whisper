{
  "name": "alex-dictate",
  "version": "1.2.0",
  "description": "Polished local-first cross-platform voice dictation with guided setup, resilient STT fallbacks, realtime preview and one-click updates.",
  "main": "src/main.js",
  "author": {
    "name": "Zoroboak",
    "email": "noreply@github.com"
  },
  "license": "MIT",
  "desktopName": "com.zoroboak.AlexDictate.desktop",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "test:electron": "node scripts/electron-smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "playwright": "1.55.1"
  },
  "build": {
    "appId": "com.zoroboak.AlexDictate",
    "productName": "Alex Dictate",
    "asar": true,
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "README.md",
      "docs/**/*",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "desktop": {
        "entry": {
          "Name": "Alex Dictate",
          "Comment": "Voice dictation in any application",
          "StartupWMClass": "Alex Dictate"
        }
      },
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Alex Dictate needs microphone access to transcribe your voice.",
        "NSAppleEventsUsageDescription": "Alex Dictate uses accessibility automation to paste transcribed text into the active application."
      },
      "icon": "assets/icon.png"
    },
    "protocols": [
      {
        "name": "Alex Dictate",
        "schemes": [
          "alex-dictate"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Zoroboak",
        "repo": "simple-windows-super-whisper",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "scripts/setup-kde-wayland.sh",
        "to": "scripts/setup-kde-wayland.sh"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
